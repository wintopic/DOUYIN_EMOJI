{
  "name": "douyin-emoji-downloader",
  "version": "1.0.0",
  "type": "module",
  "description": "抖音表情包下载工具 - 支持单张/批量下载，开源免费",
  "keywords": [
    "douyin",
    "emoji",
    "downloader",
    "vue3",
    "typescript"
  ],
  "author": "wintopic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wintopic/DOUYIN_EMOJI.git"
  },
  "homepage": "https://github.com/wintopic/DOUYIN_EMOJI#readme",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,json}\"",
    "typecheck": "vue-tsc --noEmit",
    "cf:preview": "npm run build && wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name douyin-emoji-downloader"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "prettier": "^3.2.5",
    "typescript": "~5.4.2",
    "typescript-eslint": "^7.1.0",
    "vite": "^5.1.5",
    "vue-tsc": "^2.0.6",
    "wrangler": "^4.0.0"
  }
}
